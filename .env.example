# Public read-only RPC settings. Defaults work without any secrets.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HOODI_RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
# Optional explorer API key; configure privately in Vercel environment settings.
BLOCKSCOUT_API_KEY=
REQUEST_TIMEOUT_MS=12000
PORT=3000
# No wallet private key, seed phrase or signing password is used.
